<?xml version="1.0" encoding="utf-8"?>
<!-- A merged manifest as the app's release build had it before TV-1: a phone app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.skjaere.usenet"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="io.skjaere.usenet.app.UsenetApplication"
        android:icon="@android:drawable/ic_media_play"
        android:label="@string/app_name" >
        <activity
            android:name="io.skjaere.usenet.app.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.skjaere.usenet.app.PlayerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
    </application>

</manifest>
